{
  "baseUrl": "http://localhost:4000",
  "endpoints": [
    {
      "name": "createMutableUser",
      "method": "POST",
      "path": "/mutable-users",
      "params": {
        "name": { "type": "string", "min": 1, "max": 20 }
      },
      "testCount": 10,
      "allowMutations": true,
      "cleanup": {
        "path": "/mutable-users/{{responseField}}",
        "method": "DELETE",
        "responseField": "id"
      }
    }
  ]
}